00034         \{\par
00035             free(cur->components);\par
00036             cur->components = NULL;\par
00037         \}\par
00038 \par
00039         (*cur) = (EngineEntity)\{ 0 \};\par
00040         cur = NULL;\par
00041     \}\par
00042     ctx->nentities = 0;\par
00043 \}\par
00044 \par
00045 {\cf18 void} engineDestroyEntity(EngineContext* ctx, EngineEntityKey key)\par
00046 \{\par
00047     EngineEntity* ent = engineGetEntity(ctx, key);\par
