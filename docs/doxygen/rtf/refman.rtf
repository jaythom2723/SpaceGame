01118 {\cf18 int} gladLoadGLLoader(GLADloadproc load) \{\par
01119     GLVersion.major = 0; GLVersion.minor = 0;\par
01120     glGetString = (PFNGLGETSTRINGPROC)load({\cf22 "glGetString"});\par
