00057 \par
00058     {\cf19 return} ETRUE;\par
00059 \}\par
00060 \par
00061 {\cf17 const} EBOOL engineHasComponent(EngineContext* ctx, EngineEntityKey key, EngineComponentType type)\par
00062 \{\par
