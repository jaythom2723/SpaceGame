00065     glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 3);\par
00066     glfwWindowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_CORE_PROFILE);\par
00067     ctx->window = glfwCreateWindow(config.width, config.height, config.title, NULL, NULL);\par
