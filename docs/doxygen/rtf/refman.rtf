01064 {\cf17 static} {\cf18 void} find_coreGL({\cf18 void}) \{\par
01065 \par
01066     {\cf20 /* Thank you @elmindreda}\par
01067 {\cf20      * https://github.com/elmindreda/greg/blob/master/templates/greg.c.in#L176}\par
01068 {\cf20      * https://github.com/glfw/glfw/blob/master/src/context.c#L36}\par
01069 {\cf20      */}\par
01070     {\cf18 int} i, major, minor;\par
01071 \par
01072     {\cf17 const} {\cf18 char}* version;\par
01073     {\cf17 const} {\cf18 char}* prefixes[] = \{\par
01074         {\cf22 "OpenGL ES-CM "},\par
01075         {\cf22 "OpenGL ES-CL "},\par
01076         {\cf22 "OpenGL ES "},\par
01077         NULL\par
01078     \};\par
01079 \par
01080     version = ({\cf17 const} {\cf18 char}*) glGetString(GL_VERSION);\par
01081     {\cf19 if} (!version) {\cf19 return};\par
01082 \par
01083     {\cf19 for} (i = 0;  prefixes[i];  i++) \{\par
01084         {\cf17 const} {\cf18 size_t} length = strlen(prefixes[i]);\par
01085         {\cf19 if} (strncmp(version, prefixes[i], length) == 0) \{\par
01086             version += length;\par
01087             {\cf19 break};\par
01088         \}\par
01089     \}\par
01090 \par
01091 {\cf20 /* PR #18 */}\par
01092 {\cf21 #ifdef _MSC_VER}\par
01093     sscanf_s(version, {\cf22 "%d.%d"}, &major, &minor);\par
01094 {\cf21 #else}\par
01095     sscanf(version, {\cf22 "%d.%d"}, &major, &minor);\par
01096 {\cf21 #endif}\par
01097 \par
01098     GLVersion.major = major; GLVersion.minor = minor;\par
01099     max_loaded_major = major; max_loaded_minor = minor;\par
01100     GLAD_GL_VERSION_1_0 = (major == 1 && minor >= 0) || major > 1;\par
01101     GLAD_GL_VERSION_1_1 = (major == 1 && minor >= 1) || major > 1;\par
01102     GLAD_GL_VERSION_1_2 = (major == 1 && minor >= 2) || major > 1;\par
01103     GLAD_GL_VERSION_1_3 = (major == 1 && minor >= 3) || major > 1;\par
01104     GLAD_GL_VERSION_1_4 = (major == 1 && minor >= 4) || major > 1;\par
01105     GLAD_GL_VERSION_1_5 = (major == 1 && minor >= 5) || major > 1;\par
01106     GLAD_GL_VERSION_2_0 = (major == 2 && minor >= 0) || major > 2;\par
01107     GLAD_GL_VERSION_2_1 = (major == 2 && minor >= 1) || major > 2;\par
01108     GLAD_GL_VERSION_3_0 = (major == 3 && minor >= 0) || major > 3;\par
01109     GLAD_GL_VERSION_3_1 = (major == 3 && minor >= 1) || major > 3;\par
01110     GLAD_GL_VERSION_3_2 = (major == 3 && minor >= 2) || major > 3;\par
01111     GLAD_GL_VERSION_3_3 = (major == 3 && minor >= 3) || major > 3;\par
01112     {\cf19 if} (GLVersion.major > 3 || (GLVersion.major >= 3 && GLVersion.minor >= 3)) \{\par
01113         max_loaded_major = 3;\par
01114         max_loaded_minor = 3;\par
01115     \}\par
01116 \}\par
