\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid 00001 {\cf21 #include "engine_textures.h"}\par
00002 \par
00003 {\cf21 #include <stdio.h>}\par
