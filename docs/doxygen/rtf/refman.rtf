00010 {\cf17 static} {\cf17 inline} {\cf18 void} getModelMatrix(vec2 pos, vec2 size, {\cf18 float} rotation, mat4 model)\par
00011 \{\par
00012     glm_translate(model, (vec3) \{ pos[0], pos[1], 0.0f \}); {\cf20 // move to world position}\par
00013     glm_translate(model, (vec3) \{ 0.5f * size[0], 0.5f * size[1], 0.0f \}); {\cf20 // move origin to center of quad}\par
00014     glm_rotate(model, glm_rad(rotation), (vec3) \{ 0.0f, 0.0f, 1.0f \}); {\cf20 // rotate over z-axis}\par
00015     glm_translate(model, (vec3) \{ -0.5f * size[0], -0.5f * size[1], 0.0f \}); {\cf20 // reset origin}\par
00016     glm_scale(model, (vec3) \{ size[0], size[1], 1.0f \}); {\cf20 // scale up to width,height}\par
00017 \}\par
00018 \par
00019 {\cf18 void} engineRenderEntity(EngineContext* ctx, EngineEntityKey key)\par
00020 \{\par
00021     mat4 model;\par
00022     EngineEntity* ent = engineGetEntity(ctx, key);\par
00023     assert(ent != NULL);\par
00024 \par
00025     glm_mat4_identity(model);\par
00026     engineUseShader(ctx);\par
00027     getModelMatrix((vec2) \{ ent->x, ent->y \}, (vec2) \{ ent->width, ent->height \}, 0.0f, model);\par
00028     engineSetMatrix4fv(ctx, {\cf22 "model"}, model);\par
00029 \par
00030     glActiveTexture(GL_TEXTURE0);\par
00031     engineBindTexture(ctx, ent->texkey);\par
00032 \par
00033     assert(glIsVertexArray(ctx->vao) != 0);\par
00034 \par
00035     engineBindVAO(ctx->vao);\par
00036     glDrawArrays(GL_TRIANGLES, 0, 6);\par
00037     engineBindVAO(0);\par
00038 \}\par
}
