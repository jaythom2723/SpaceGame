00007 EngineLinkedList* engineCreateLinkedList({\cf18 char}* lista, {\cf18 char}* listb, {\cf18 size_t} arrsize, {\cf18 size_t} typesize)\par
00008 \{\par
00009     EngineLinkedList* list = malloc({\cf17 sizeof}(EngineLinkedList));\par
00010     {\cf19 if} (list == NULL)\par
00011         {\cf19 return} NULL;\par
00012 \par
00013     list->lista = malloc(arrsize * typesize);\par
00014     {\cf19 if} (list->lista == NULL)\par
00015     \{\par
00016         free(list);\par
00017         {\cf19 return} NULL;\par
00018     \}\par
00019 \par
00020     list->listb = malloc(arrsize * typesize);\par
00021     {\cf19 if} (list->listb == NULL)\par
00022     \{\par
00023         free(list->lista);\par
00024         free(list);\par
00025         {\cf19 return} NULL;\par
00026     \}\par
00027 \par
00028 \par
00029     list->arrsize = arrsize;\par
00030     list->typesize = typesize;\par
00031 \par
00032     memset(list->lista, 0, arrsize * typesize);\par
00033     memset(list->listb, 0, arrsize * typesize);\par
00034 \par
00035     {\cf19 if} (lista != NULL)\par
00036         memcpy(list->lista, lista, arrsize * typesize);\par
00037 \par
00038     {\cf19 if} (listb != NULL)\par
00039         memcpy(list->listb, listb, arrsize * typesize);\par
00040 \par
00041     {\cf19 return} list;\par
00042 \}\par
00043 \par
00044 {\cf18 void} engineDestroyLinkedList(EngineLinkedList* list)\par
00045 \{\par
00046     free(list->lista);\par
00047     list->lista = NULL;\par
00048 \par
00049     free(list->listb);\par
00050     list->listb = NULL;\par
00051 \par
00052     free(list);\par
00053     list = NULL;\par
00054 \}\par
00055 \par
00056 {\cf17 const} EBOOL _checkisoutbounds(EngineLinkedList* list, {\cf18 int} index)\par
00057 \{\par
00058     {\cf19 return} (list->lista + index > list->lista + list->arrsize\par
00059             || list->listb + index > list->listb + list->arrsize\par
00060         );\par
00061 \}\par
00062 \par
00063 {\cf17 const} EBOOL engineSetValue(EngineLinkedList* list, {\cf18 int} index, {\cf18 int} value)\par
00064 \{\par
00065     {\cf19 if} (_checkisoutbounds(list, index) == ETRUE)\par
00066         {\cf19 return} EFALSE;\par
00067 \par
00068     memset(list->lista + index, value, list->typesize);\par
00069     memset(list->listb + index, value, list->typesize);\par
00070 \par
00071     {\cf19 return} ETRUE;\par
00072 \}\par
00073 \par
00074 {\cf18 void} engineGetValues(EngineLinkedList* list, {\cf18 char}* desta, {\cf18 char}* destb)\par
00075 \{\par
00076     {\cf19 if} (desta != NULL)\par
00077         memcpy(desta, list->lista, list->arrsize * list->typesize);\par
00078 \par
00079     {\cf19 if} (destb != NULL)\par
00080         memcpy(destb, list->listb, list->arrsize * list->typesize);\par
00081 \}\par
00082 \par
00083 {\cf18 char}* engineReadFile({\cf17 const} {\cf18 char}* path)\par
00084 \{\par
00085     {\cf18 char}* source;\par
00086     {\cf18 size_t} size;\par
00087     FILE* fp;\par
00088 \par
00089     fp = fopen(path, {\cf22 "rb"});\par
00090     {\cf19 if} (fp == NULL)\par
00091     \{\par
00092         fprintf(stderr, {\cf22 "Could not find file specified!\\n\\t%s\\n"}, path);\par
00093         {\cf19 return} NULL;\par
00094     \}\par
00095 \par
00096     fseek(fp, 0l, SEEK_END);\par
00097     size = ftell(fp);\par
00098     rewind(fp);\par
00099 \par
00100     source = calloc(size + 1, {\cf17 sizeof}({\cf18 char}));\par
00101     {\cf19 if} (source == NULL)\par
00102     \{\par
00103         fprintf(stderr, {\cf22 "Could not read the file!\\n\\t%s\\n"}, path);\par
00104         fclose(fp);\par
00105         {\cf19 return} NULL;\par
00106     \}\par
00107     fread(source, {\cf17 sizeof}({\cf18 char}), size + 1, fp);\par
00108 \par
00109     fclose(fp);\par
00110 \par
00111     {\cf19 return} source;\par
00112 \}\par
}
