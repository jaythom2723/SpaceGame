00011 \par
00012 {\cf17 static} EngineTexturePair* ptr = NULL;\par
00013 {\cf17 static} EngineTexturePair* lastElem = NULL;\par
00014 {\cf17 static} EngineTexturePair* end = NULL;\par
00015 \par
00016 {\cf17 static} EngineTexturePair* _engineGetTexturePair(EngineContext* ctx, {\cf18 unsigned} {\cf18 int} key, {\cf18 unsigned} {\cf18 int}* index);\par
00017 {\cf17 static} EngineTexturePair* _engineGetTexturePairIndex(EngineContext* ctx, {\cf18 unsigned} {\cf18 int} index);\par
00018 \par
00019 {\cf17 const} EBOOL engineCreateTexture(EngineContext* ctx, {\cf18 unsigned} {\cf18 int} key)\par
00020 \{\par
00021     {\cf19 if} (ptr == NULL)\par
00022     \{\par
00023         ptr = ctx->textures;\par
00024         lastElem = ctx->textures;\par
00025         end = ctx->textures + ENGINE_MAX_TEXTURES;\par
00026     \}\par
00027 \par
00028     {\cf20 // do nothing if we're at the max amount of textures}\par
00029     {\cf19 if} (ptr >= end)\par
00030         {\cf19 return} EFALSE;\par
00031 \par
00032     EngineTexture* texture = malloc({\cf17 sizeof}(EngineTexture));\par
00033     {\cf19 if} (texture == NULL)\par
00034     \{\par
00035         fprintf(stderr, {\cf22 "Could not allocate enough memory for a texture!\\n"});\par
00036         {\cf19 return} EFALSE;\par
00037     \}\par
00038 \par
00039     glGenTextures(1, &texture->id);\par
00040 \par
00041     EngineTexturePair pair = \{\par
00042         .key = key,\par
00043         .value = texture\par
00044     \};\par
00045 \par
00046     (*ptr) = pair;\par
00047     ctx->ntextures++;\par
00048 \par
00049     {\cf19 if} (ptr != lastElem)\par
00050     \{\par
00051         ptr = lastElem;\par
00052     \}\par
00053     {\cf19 else}\par
00054     \{\par
00055         ptr++;\par
00056         lastElem++;\par
00057     \}\par
00058 \par
00059     {\cf19 return} ETRUE;\par
00060 \}\par
00061 \par
00062 {\cf17 const} EBOOL engineGenerateTexture(EngineContext* ctx, {\cf18 unsigned} {\cf18 int} key, {\cf17 const} {\cf18 char}* path, {\cf17 const} EBOOL alpha)\par
00063 \{\par
00064     EngineTexturePair* pair = NULL;\par
00065 \par
00066     {\cf19 for} ({\cf18 int} i = 0; i < (int)(ptr - ctx->textures); i++)\par
00067     \{\par
00068         {\cf19 if} (ctx->textures[i].key != key)\par
00069             {\cf19 continue};\par
00070         pair = &ctx->textures[i];\par
00071         {\cf19 break};\par
00072     \}\par
00073 \par
00074     {\cf19 if} (pair == NULL)\par
00075         {\cf19 return} EFALSE;\par
00076 \par
00077     pair->value->width = 0;\par
00078     pair->value->height = 0;\par
00079     pair->value->internalformat = GL_RGB;\par
00080     pair->value->imageformat = GL_RGB;\par
00081     pair->value->wraps = GL_REPEAT;\par
00082     pair->value->wrapt = GL_REPEAT;\par
00083     pair->value->filtermax = GL_LINEAR;\par
00084     pair->value->filtermin = GL_LINEAR;\par
00085 \par
00086     {\cf19 if} (alpha)\par
00087     \{\par
00088         pair->value->internalformat = GL_RGBA;\par
00089         pair->value->imageformat = GL_RGBA;\par
00090     \}\par
00091 \par
00092     {\cf18 int} width, height, nrChannels;\par
00093     {\cf18 unsigned} {\cf18 char}* data = stbi_load(path, &width, &height, &nrChannels, 0);\par
00094     {\cf19 if} (data == NULL)\par
00095     \{\par
00096         fprintf(stderr, {\cf22 "Could not find texture file!\\n"});\par
00097         {\cf19 return} EFALSE;\par
00098     \}\par
00099 \par
00100     glBindTexture(GL_TEXTURE_2D, pair->value->id);\par
00101     glTexImage2D(GL_TEXTURE_2D, 0, pair->value->internalformat, width, height, 0, pair->value->imageformat, GL_UNSIGNED_BYTE, data);\par
00102 \par
00103     glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, pair->value->wraps);\par
00104     glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, pair->value->wrapt);\par
00105     glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, pair->value->filtermin);\par
00106     glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, pair->value->filtermax);\par
00107 \par
00108     glBindTexture(GL_TEXTURE_2D, 0);\par
00109 \par
00110     stbi_image_free(data);\par
00111     \par
00112     {\cf19 return} ETRUE;\par
00113 \}\par
00114 \par
00115 {\cf18 void} engineGenTextureCheckMissing(EngineContext* ctx, {\cf18 unsigned} {\cf18 int} key, {\cf17 const} {\cf18 char}* path, {\cf17 const} EBOOL alpha)\par
00116 \{\par
00117     {\cf19 if} (engineCreateTexture(ctx, key) != EFALSE)\par
00118         {\cf19 if} (engineGenerateTexture(ctx, key, path, alpha) == EFALSE)\par
00119             engineGenerateTexture(ctx, ENGINE_MISSING_TEXTURE_KEY, {\cf22 "Textures/_missing_texture.png"}, EFALSE);\par
00120 \}\par
00121 \par
00122 {\cf18 void} engineBindTexture(EngineContext* ctx, {\cf18 unsigned} {\cf18 int} key)\par
00123 \{\par
00124     {\cf18 int} index;\par
00125     EngineTexturePair* pair = _engineGetTexturePair(ctx, key, &index);\par
00126     assert(pair != NULL);\par
00127     assert(pair->value != NULL);\par
00128     assert(glIsTexture(pair->value->id) != 0);\par
00129     glBindTexture(GL_TEXTURE_2D, pair->value->id);\par
00130 \}\par
00131 \par
00132 {\cf18 void} engineDestroyAllTextures(EngineContext* ctx)\par
00133 \{\par
00134     {\cf19 for} ({\cf18 int} i = 0; i < (int)(ptr - ctx->textures); i++)\par
00135     \{\par
00136         EngineTexturePair* pair = _engineGetTexturePairIndex(ctx, i);\par
00137         {\cf19 if} (pair->value == NULL)\par
00138             {\cf19 continue};\par
00139 \par
00140         glDeleteTextures(1, &pair->value->id);\par
00141         free(pair->value);\par
00142         pair->value = NULL;\par
00143         pair->key = 0;\par
00144     \}\par
00145 \par
00146     ptr = ctx->textures;\par
00147     lastElem = ctx->textures;\par
00148     ctx->ntextures = 0;\par
00149 \}\par
00150 \par
00151 {\cf18 void} engineDestroyTexture(EngineContext* ctx, {\cf18 unsigned} {\cf18 int} key)\par
00152 \{\par
00153     {\cf18 int} index;\par
00154     EngineTexturePair* pair = _engineGetTexturePair(ctx, key, &index);\par
00155 \par
00156     glDeleteTextures(1, &pair->value->id);\par
00157     free(pair->value);\par
00158     pair->value = NULL;\par
00159     pair->key = 0;\par
00160 \par
00161     ctx->ntextures--;\par
00162 \par
00163     {\cf19 if} ((EngineTexturePair*)(ctx->textures + index) == lastElem)\par
00164     \{\par
00165         lastElem--;\par
00166         ptr--;\par
00167     \}\par
00168     {\cf19 else}\par
00169     \{\par
00170         ptr = (EngineTexturePair*)(ctx->textures + index);\par
00171     \}\par
00172 \}\par
00173 \par
00174 {\cf20 // internal functions}\par
00175 EngineTexturePair* _engineGetTexturePair(EngineContext* ctx, {\cf18 unsigned} {\cf18 int} key, {\cf18 unsigned} {\cf18 int}* index)\par
00176 \{\par
00177     {\cf19 for} ({\cf18 int} i = 0; i < (int)(ptr - ctx->textures); i++)\par
00178     \{\par
00179         {\cf19 if} (ctx->textures[i].key == key)\par
00180         \{\par
00181             (*index) = i;\par
00182             {\cf19 return} &ctx->textures[i];\par
00183         \}\par
00184     \}\par
00185     {\cf19 return} NULL;\par
00186 \}\par
00187 \par
00188 EngineTexturePair* _engineGetTexturePairIndex(EngineContext* ctx, {\cf18 unsigned} {\cf18 int} index)\par
00189 \{\par
00190     {\cf19 return} &ctx->textures[index];\par
00191 \}\par
00192 \par
}
